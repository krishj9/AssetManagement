# Terraform Variables Example
# Copy this file to terraform.tfvars and update with your values

# AWS Configuration
aws_region  = "us-east-1"
environment = "dev"  # Options: dev, test, pre-prod, prod

# Project Configuration
project_name = "bedrock-portfolio-platform"

# DynamoDB Configuration
dynamodb_billing_mode           = "PAY_PER_REQUEST"  # Options: PAY_PER_REQUEST, PROVISIONED
dynamodb_point_in_time_recovery = true

# Bedrock Configuration
bedrock_model_id = "anthropic.claude-3-sonnet-20240229-v1:0"
# Optional: Provide existing guardrail ID if you have one
# bedrock_guardrail_id = ""

# API Gateway Configuration
api_gateway_stage_name           = "v1"
api_gateway_throttle_burst_limit = 5000
api_gateway_throttle_rate_limit  = 10000

# CloudWatch Configuration
cloudwatch_log_retention_days = 30
# Optional: Provide email for alarm notifications
# cloudwatch_alarm_email = "your-email@example.com"

# Additional Tags
additional_tags = {
  Owner       = "Platform Team"
  CostCenter  = "Engineering"
  Compliance  = "Required"
}
